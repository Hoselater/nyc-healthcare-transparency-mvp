# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# --- Database -------------------------------------------------------------
# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/nyc_healthcare_mvp
# ...or set the parts:
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyc_healthcare_mvp

# --- SPARCS (Health Data NY) ---------------------------------------------
# Which release year(s) to pull, comma-separated. Stacking years raises
# per-facility volume and stabilises the O/E ratios; benchmarks are stratified
# by discharge year so pooling does not smear year-over-year LOS drift.
SPARCS_YEARS=2022,2024
# Pin a single dataset directly, overriding SPARCS_YEARS entirely.
# SPARCS_DATASET_ID=5dtw-tffi

# Free, and strongly recommended: anonymous requests are throttled hard.
# Register at https://health.data.ny.gov/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

SOCRATA_PAGE_SIZE=50000
# Cap total records pulled (0 = no cap). Useful for a quick smoke run.
SOCRATA_MAX_RECORDS=0

# --- CMS MRF --------------------------------------------------------------
TARGET_MS_DRG=470
MRF_BATCH_ROWS=5000
# Cap rows scanned per MRF (0 = unlimited). Set to e.g. 200000 to test quickly.
MRF_MAX_ROWS_SCANNED=0
HTTP_USER_AGENT=nyc-healthcare-transparency-mvp/1.0 (portfolio research project)

# --- Entity resolution ----------------------------------------------------
FUZZY_MIN_SCORE=80
FUZZY_AUTO_ACCEPT=97
